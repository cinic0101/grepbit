{
  "datasource_id": "pos_real",
  "revision": "pos-real-overlay-v10",
  "metrics": [
    {
      "id": "return_amount",
      "names": [
        "退貨金額",
        "退貨總金額",
        "退款金額",
        "return amount",
        "refund amount"
      ],
      "description": "Sum of pos_sale.total_amount over transactions that reference an origin transaction (pos_sale.origin_transaction_no is set); the owner confirmed on 2026-09-09 that such a transaction is a return. Signed by the owner on 2026-09-09.",
      "base_table": "pos_sale",
      "aggregate": "sum",
      "column": {
        "table": "pos_sale",
        "column": "total_amount"
      },
      "filters": [
        {
          "column": {
            "table": "pos_sale",
            "column": "origin_transaction_no"
          },
          "op": "not_null"
        }
      ],
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "return_count",
      "names": [
        "退貨筆數",
        "退貨交易筆數",
        "退貨交易數",
        "幾筆退貨",
        "return count",
        "number of returns"
      ],
      "description": "Count of pos_sale rows that reference an origin transaction (origin_transaction_no is set). Signed by the owner on 2026-09-09.",
      "base_table": "pos_sale",
      "aggregate": "count",
      "filters": [
        {
          "column": {
            "table": "pos_sale",
            "column": "origin_transaction_no"
          },
          "op": "not_null"
        }
      ],
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "return_quantity",
      "names": [
        "退貨數量",
        "退貨件數",
        "return quantity",
        "returned units"
      ],
      "description": "Sum of pos_saleitem.quantity over line items whose transaction references an origin transaction (pos_sale.origin_transaction_no is set). Signed by the owner on 2026-09-09.",
      "base_table": "pos_saleitem",
      "aggregate": "sum",
      "column": {
        "table": "pos_saleitem",
        "column": "quantity"
      },
      "filters": [
        {
          "column": {
            "table": "pos_sale",
            "column": "origin_transaction_no"
          },
          "op": "not_null"
        }
      ],
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "paid_amount",
      "names": [
        "已付款金額",
        "已付款訂單的總金額",
        "已付款總額",
        "付款總額",
        "paid amount",
        "total payments"
      ],
      "description": "Sum of pos_payment.payment_amount. Payments carry no status: every pos_payment row is a completed payment, so 'paid' means every payment. Time is the sale_date of the paid transaction. Signed by the owner on 2026-09-09.",
      "base_table": "pos_payment",
      "aggregate": "sum",
      "column": {
        "table": "pos_payment",
        "column": "payment_amount"
      },
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "average_ticket",
      "names": [
        "客單價",
        "平均客單價",
        "平均交易金額",
        "average ticket",
        "average order value",
        "AOV"
      ],
      "description": "Average of pos_sale.total_amount per sales transaction (one pos_sale row is one transaction, so this equals total sales divided by transaction count). Returns are excluded by the default returns segment unless the question includes them. Valid only over pos_sale; a per-category ticket needs the ratio metric planned for the next phase. Signed by the owner on 2026-09-09.",
      "base_table": "pos_sale",
      "aggregate": "avg",
      "column": {
        "table": "pos_sale",
        "column": "total_amount"
      },
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "transaction_count",
      "names": [
        "交易筆數",
        "銷售交易筆數",
        "交易數",
        "銷售筆數",
        "transaction count",
        "number of transactions"
      ],
      "description": "Count of pos_sale rows; one row is one sales transaction, so this equals the number of distinct transaction numbers, including zero-amount service transactions (SIM renewals, service fees, memberships; the owner decided on 2026-09-10 to count them; a metric filter total_amount ne 0 would exclude them). Returns are excluded by the default returns segment unless the question includes them.",
      "base_table": "pos_sale",
      "aggregate": "count",
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "paid_transaction_count",
      "names": [
        "付款交易筆數",
        "各付款方式的交易筆數",
        "有付款的交易筆數",
        "paid transaction count"
      ],
      "description": "Count of distinct pos_payment.transaction_no: transactions with at least one payment row, counted once even when paid in several parts. Zero-amount service transactions (SIM renewals, service fees, memberships) carry no payment row and are not counted here; transaction_count over pos_sale counts them. Signed by the owner on 2026-09-10.",
      "base_table": "pos_payment",
      "aggregate": "count_distinct",
      "column": {
        "table": "pos_payment",
        "column": "transaction_no"
      },
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "gross_sales",
      "names": [
        "銷售總額",
        "營業額",
        "銷售額",
        "銷售毛額",
        "gross sales",
        "sales total",
        "revenue"
      ],
      "description": "Sum of pos_sale.total_amount over sales that are not returns (origin_transaction_no is null): gross sales, the denominator of return ratios by retail convention. Signed by the owner on 2026-09-10. Per product or per category sales are line_sales over pos_saleitem, not this metric.",
      "base_table": "pos_sale",
      "aggregate": "sum",
      "column": {
        "table": "pos_sale",
        "column": "total_amount"
      },
      "filters": [
        {
          "column": {
            "table": "pos_sale",
            "column": "origin_transaction_no"
          },
          "op": "is_null"
        }
      ],
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "net_sales",
      "names": [
        "淨銷售額",
        "含退貨營業額",
        "淨營業額",
        "net sales"
      ],
      "description": "Sum of pos_sale.total_amount over every sale including returns (which are negative): net sales. Ask for it by name; 銷售總額 alone means gross sales. Signed by the owner on 2026-09-10.",
      "base_table": "pos_sale",
      "aggregate": "sum",
      "column": {
        "table": "pos_sale",
        "column": "total_amount"
      },
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    },
    {
      "id": "line_sales",
      "names": [
        "商品銷售金額",
        "商品銷售額",
        "分類銷售額",
        "明細銷售金額",
        "line sales",
        "product sales"
      ],
      "description": "Sum of pos_saleitem.amount over line items whose sale is not a return (pos_sale.origin_transaction_no is null): sales at product or category grain, the counterpart of gross_sales for questions grouped by product or category. Signed by the owner on 2026-09-10.",
      "base_table": "pos_saleitem",
      "aggregate": "sum",
      "column": {
        "table": "pos_saleitem",
        "column": "amount"
      },
      "filters": [
        {
          "column": {
            "table": "pos_sale",
            "column": "origin_transaction_no"
          },
          "op": "is_null"
        }
      ],
      "time_column": {
        "table": "pos_sale",
        "column": "sale_date"
      },
      "review_state": "verified"
    }
  ],
  "absent_concepts": [
    {
      "names": [
        "訂單狀態",
        "交易狀態",
        "order status"
      ],
      "note": "An order's status is the latest shipment status (transfer_status.status, ordered by status_time) of the transfer its sale references; a transfer has several status rows over time, so this cannot be expressed as one aggregate yet (a latest-row-per-entity construct is planned). The count of shipment status records by status is answerable, but it counts records, not orders.",
      "all_of": [
        [
          "訂單",
          "狀態"
        ],
        [
          "交易",
          "狀態"
        ],
        [
          "order",
          "status"
        ]
      ]
    },
    {
      "names": [
        "取消的訂單",
        "取消訂單",
        "已取消",
        "cancelled order",
        "canceled order"
      ],
      "note": "Cancellations are not recorded; only returns (origin_transaction_no set) exist."
    },
    {
      "names": [
        "未付款",
        "付款狀態",
        "unpaid",
        "payment status"
      ],
      "note": "Payments carry no status; every pos_payment row is a completed payment, so unpaid or pending payments cannot be identified."
    }
  ],
